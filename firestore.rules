rules_version = '2';
// Firestore rules for shriramjiastro-cee67.
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Each visitor can read and change only their own profile and kundalis (written by sra-auth.js).
// The owner's Google accounts can read every account and kundali (admin.html → Website Accounts).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['eshriee@gmail.com', 'shriramjiastro7@gmail.com'];
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);

      match /kundalis/{kundaliId} {
        allow read: if isOwner(uid) || isAdmin();
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.keys().size() < 40;
      }
    }

    // Admin portal lists every kundali in one query (collection group)
    match /{path=**}/kundalis/{kundaliId} {
      allow read: if isAdmin();
    }

    // Records the website sends (sra-records.js): visitors may only add them, the admin reads them
    function smallRecord() {
      return request.resource.data.keys().size() < 60;
    }
    match /consultations/{id} { allow create: if smallRecord(); allow read, update, delete: if isAdmin(); }
    match /payments/{id}      { allow create: if smallRecord(); allow read, update, delete: if isAdmin(); }
    match /students/{id}      { allow create: if smallRecord(); allow read, update, delete: if isAdmin(); }
    match /user_queries/{id}  { allow create: if smallRecord(); allow read, update, delete: if isAdmin(); }
    match /career_applications/{id} {
      allow create: if smallRecord();
      allow read: if true;
      allow update, delete: if isAdmin();
    }
    // Articles from about.html: the admin's Google account publishes directly, others wait for approval
    match /forum_posts/{id} {
      allow create: if request.resource.data.status == 'pending' || isAdmin();
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }
    // Reviews arrive as pending; only approved ones are public (consultation page slideshow)
    match /reviews/{id} {
      allow create: if smallRecord() && request.resource.data.status == 'pending';
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // SUTRADHAR REFERRAL & AUTOMATED PAYOUT ENGINE (SERVER-ONLY WRITES)
    // Browser can never write directly; only Render Python engine (Admin SDK) writes.
    // Sutradhar can only read their own documents.
    // =========================================================================
    match /sutradhars/{sutradharId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.uid == request.auth.uid || resource.data.phone == request.auth.token.phone_number));
      allow write: if false;
    }

    match /leads/{leadId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.sutradhar_uid == request.auth.uid || resource.data.sutradhar_phone == request.auth.token.phone_number));
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.customer_uid == request.auth.uid || resource.data.customer_phone == request.auth.token.phone_number || resource.data.sutradhar_uid == request.auth.uid));
      allow write: if false;
    }

    match /commissions/{commId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.sutradhar_uid == request.auth.uid || resource.data.sutradhar_phone == request.auth.token.phone_number));
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
